# PodifyAI — 环境变量完整示例
# 复制为 .env.local 后填入真实值，所有带 * 的为必填项

# ─── 核心安全 ───────────────────────────────────────────────
SECRET_KEY=replace-with-random-secret-key              # * Flask session 密钥
ALLOWED_ORIGINS=http://localhost:5000,https://yourdomain.com  # CORS 白名单

# ─── SiliconFlow TTS ────────────────────────────────────────
SILICONFLOW_API_KEY=replace-with-siliconflow-api-key    # * TTS 合成 API key
SILICONFLOW_API_BASE=https://api.siliconflow.cn/v1      # 默认值，可省略
SF_TTS_MODEL=FunAudioLLM/CosyVoice2-0.5B               # 默认值，可省略

# ─── Gemini / OpenAI 脚本生成 ───────────────────────────────
OPENAI_API_KEY=replace-with-gemini-or-openai-api-key    # * Podcast 脚本生成
OPENAI_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai/

# ─── 积分 & 功能开关 ─────────────────────────────────────────
CREDITS_PER_AUDIO=10                # 每次合成扣除积分数
ENABLE_PAID_VOICES=false            # 是否启用付费音色
MIN_ARTICLE_CHARS=100               # URL/文章最少字数

# ─── 认证策略 ────────────────────────────────────────────────
ALLOW_PASSWORD_LOGIN=true           # 是否允许密码登录
ALLOW_LEGACY_PASSWORD_LOGIN=false   # 是否允许旧版密码（兼容）
REQUIRE_CONTACT_VERIFICATION=false  # 是否强制邮箱/手机验证
OTP_DEV_LOG_ONLY=true               # 开发模式：OTP 仅打印不发送

# ─── 邮件 (二选一) ───────────────────────────────────────────
# 方案 A: SendGrid (推荐生产)
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=replace-with-sendgrid-api-key
SENDGRID_FROM=noreply@yourdomain.com
SENDGRID_FROM_NAME=PodifyAI
SENDGRID_SANDBOX=false              # true=测试模式不实际发送

# 方案 B: SMTP
# EMAIL_PROVIDER=smtp
# EMAIL_FROM=noreply@yourdomain.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_USE_TLS=true

# ─── Stripe 支付 ─────────────────────────────────────────────
STRIPE_SECRET_KEY=replace-with-stripe-secret-key
STRIPE_WEBHOOK_SECRET=replace-with-stripe-webhook-secret
STRIPE_PRICE_LITE=replace-with-lite-price-id       # Lite 套餐 price ID
STRIPE_PRICE_PRO=replace-with-pro-price-id         # Pro 套餐 price ID
STRIPE_PRICE_PACK_1000=replace-with-1000-pack-id   # 1000 积分包
STRIPE_PRICE_PACK_3000=replace-with-3000-pack-id   # 3000 积分包
STRIPE_SUCCESS_URL=https://yourdomain.com/payment/success
STRIPE_CANCEL_URL=https://yourdomain.com/payment/cancel

# ─── 短信 OTP (三选一，均可不填) ────────────────────────────
# Twilio
# TWILIO_ACCOUNT_SID=replace-with-twilio-account-sid
# TWILIO_AUTH_TOKEN=replace-with-twilio-auth-token
# TWILIO_FROM_NUMBER=+1xxxxxxxxxx

# 阿里云
# ALIYUN_ACCESS_KEY_ID=replace-with-aliyun-access-key-id
# ALIYUN_ACCESS_KEY_SECRET=replace-with-aliyun-access-key-secret
# ALIYUN_SMS_SIGN_NAME=你的签名
# ALIYUN_SMS_TEMPLATE_CODE=SMS_xxxxxxxx

# 腾讯云
# TENCENT_SECRET_ID=replace-with-tencent-secret-id
# TENCENT_SECRET_KEY=replace-with-tencent-secret-key
# TENCENT_SMS_SDK_APP_ID=xxxxxxxx
# TENCENT_SMS_SIGN_NAME=你的签名
# TENCENT_SMS_TEMPLATE_ID=xxxxxxxx

# ─── 系统路径 ────────────────────────────────────────────────
# FFMPEG_DIR=/usr/bin                # ffmpeg 目录，不填则走系统 PATH
# VOICE_PREVIEW_DIR=voice_previews   # 音色预览存储目录

# ─── 本地开发覆盖 ────────────────────────────────────────────
SESSION_COOKIE_SECURE=false          # 本地 HTTP 开发时关掉，生产删除此行（默认 true）
